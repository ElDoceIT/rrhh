# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horas_extras
DB_USER=horas_extras
DB_PASSWORD=

# Sesiones
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Active Directory
AD_SERVER_IP=
AD_SERVER_PORT=389
AD_BIND_USER=
AD_BIND_PASSWORD=
AD_DOMAIN=
AD_BASE_DN=
AD_GROUP_NAME=
AD_GROUPS_BASE_DN=
AD_LOGIN_ATTR=sAMAccountName
AD_USE_SSL=false
AD_TLS_VALIDATE_CERT=false
AD_CONNECT_TIMEOUT=5

# Administrador local de emergencia
AUTH_LOCAL_USERS=admin,root
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Admin
SEED_ADMIN_APELLIDO=Local
SEED_ADMIN_EMAIL=admin@local.invalid
